{
  "name": "duckplan-axis-first-import-qa",
  "main": "server.mjs",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "../../landing", "binding": "ASSETS", "run_worker_first": ["/api/*", "/cloud-config.js", "/__axis-qa"] },
  "d1_databases": [{ "binding": "DB", "database_name": "duckplan-axis-first-import-qa", "database_id": "00000000-0000-4000-8000-000000000096", "migrations_dir": "../../cloudflare/migrations" }],
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "PlannerLive" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlannerLive"] }],
  "vars": { "AXIS_SYNC_INTERVAL_HOURS": "4", "AXIS_SYNC_PER_RUN": "4" },
  "observability": { "enabled": false }
}
